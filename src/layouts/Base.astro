---
import '../styles/global.css';
import { site } from '../site';
const { title = site.name, description = site.description, article = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title === site.name ? title : `${title} · ${site.name}`}</title><meta name="description" content={description}/>{import.meta.env.DEV && <meta name="robots" content="noindex, nofollow"/>}{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article ? 'article' : 'website'}/>{canonical && <meta property="og:url" content={canonical}/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml"/></head><body><a class="skip" href="#main">跳到正文</a><header class="header wrap"><a class="brand" href="/"><span class="logo">方</span>{site.name}</a><nav aria-label="主导航"><a href="/">文章</a><a href="/about/">关于</a>{site.github && <a href={site.github}>GitHub ↗</a>}</nav></header><main id="main"><slot/></main><footer class="footer wrap"><div><strong>{site.name}</strong><p>把过程写清楚，让实践可以复现。</p></div><div><a href="/disclosure/">推广与隐私声明</a><a href="/rss.xml">RSS</a><span>© {new Date().getFullYear()}</span></div></footer></body></html>
